<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnSkipped="true">
  <testsuites>
    <testsuite name="unit">
      <directory>tests</directory>
      <exclude>tests/Conformance</exclude>
      <exclude>tests/EndToEnd</exclude>
    </testsuite>
    <!-- The whole SDK against conformance/stub/server.mjs, the replay of the PUBLISHED ingest contract.
         Needs node 22+ on PATH; it fails rather than skips without one. -->
    <testsuite name="endtoend">
      <directory>tests/EndToEnd</directory>
    </testsuite>
    <testsuite name="conformance">
      <directory>tests/Conformance</directory>
    </testsuite>
  </testsuites>
</phpunit>
